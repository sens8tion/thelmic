{
  "class": "Compressor2",
  "summary": "Cytomic-modelled bus compressor (the 'glue' compressor). Best on drums, master bus, group bus.",
  "alt_class_names": ["GlueCompressor", "Compressor2"],
  "params": [
    {"name": "Threshold",    "min": -36.0, "max": 0.0,    "default": 0.0,  "groups": ["dynamics"]},
    {"name": "Ratio",        "min": 0,     "max": 5,      "default": 1,    "groups": ["dynamics"], "is_quantized": true, "values": "0=2:1, 1=4:1, 2=10:1, 3=20:1, 4=50:1, 5=100:1"},
    {"name": "Attack",       "min": 0,     "max": 5,      "default": 2,    "groups": ["dynamics"], "is_quantized": true, "values": "0=0.01ms, 1=0.1ms, 2=0.3ms, 3=1ms, 4=3ms, 5=10ms, 6=30ms"},
    {"name": "Release",      "min": 0,     "max": 6,      "default": 2,    "groups": ["dynamics"], "is_quantized": true, "values": "0=0.1s, 1=0.2s, 2=0.4s, 3=0.6s, 4=0.8s, 5=1.2s, 6=Auto"},
    {"name": "Makeup",       "min": -36.0, "max": 36.0,   "default": 0.0,  "groups": ["mix"]},
    {"name": "Range",        "min": -70.0, "max": 0.0,    "default": -70.0,"groups": ["dynamics"]},
    {"name": "Dry/Wet",      "min": 0.0,   "max": 1.0,    "default": 1.0,  "groups": ["mix"]},
    {"name": "Soft Clip",    "min": 0,     "max": 1,      "default": 0,    "groups": ["limiter"], "is_quantized": true}
  ],
  "groups": {
    "dynamics": ["Threshold", "Ratio", "Attack", "Release", "Range"],
    "limiter":  ["Soft Clip"],
    "mix":      ["Makeup", "Dry/Wet"]
  },
  "musical_archetypes": {
    "drum_glue": {"Threshold": -8.0, "Ratio": 1, "Attack": 5, "Release": 6, "Makeup": 2.0},
    "master_glue": {"Threshold": -3.0, "Ratio": 0, "Attack": 4, "Release": 6, "Makeup": 1.0}
  }
}
